# 复制为 .env 后填入真实值。.env 已被 gitignore（见根 .gitignore 第 19-21 行），凭据不入库。
# Spring Boot 通过 application.yml 的 spring.config.import 直接读取本文件，不需要手动设环境变量。
# 生产环境请改用系统环境变量 / 部署平台的 secret 注入，不要部署 .env。

MYSQL_ROOT_PASSWORD=change-me-to-a-long-random-string

# 微信登录：false = 真实 code2Session（需要下方 WX_APPID/WX_SECRET 与 JWT_SECRET）；
# true = mock 登录（本地开发/演示用，生产必须 false）
WX_MOCK_LOGIN=true
WX_APPID=
WX_SECRET=
# JWT 签名密钥：真实登录（WX_MOCK_LOGIN=false）时必填，强随机长字符串
JWT_SECRET=

# 快递100 企业版（api.kuaidi100.com 管理后台）：授权 key 与授权码
# 只开通「实时查询」时填这两个即可；上门取件是另一个需单独签约的产品
EXPRESS_KEY=
EXPRESS_CUSTOMER=
# false 才会真的出网调快递100；测试环境由用例内强制为 true
EXPRESS_MOCK=true
# 物流推送回调地址，必须公网 https；本地开发留空
EXPRESS_CALLBACK_URL=

# 微信订阅消息（小程序后台「订阅消息」里申请「订单状态变更」模板后填写）
# 模板字段名是申请时随机分配的，必须照抄后台看到的编号，如 thing1 / character_string2 / time3
WX_SUBSCRIBE_TEMPLATE_ID=
WX_SUBSCRIBE_FIELD_STATUS=
WX_SUBSCRIBE_FIELD_ORDER_NO=
WX_SUBSCRIBE_FIELD_TIME=
WX_SUBSCRIBE_PAGE=pages/recycle/order/list/index

# 管理端机器令牌（Authorization: Bearer <ADMIN_TOKEN>）。
# 留空 = 禁用机器令牌，管理员改用账号密码登录。生产环境务必设置强随机值。
# 注意：compose 不再提供任何默认值，历史默认值 local-admin-token 已被守卫列为弱令牌。
ADMIN_TOKEN=
# 管理员账号密码登录的初始密码（首次启动引导创建管理员用），生产务必设置强随机值
ADMIN_BOOTSTRAP_PASSWORD=
