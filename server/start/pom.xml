<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.rephone</groupId>
        <artifactId>rephone-server</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>rephone-start</artifactId>
    <name>rephone-start</name>
    <description>启动模块：配置、数据源、Redis、多租户插件、JWT Bean</description>

    <dependencies>
        <dependency>
            <groupId>com.rephone</groupId>
            <artifactId>rephone-controller</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rephone</groupId>
            <artifactId>rephone-service</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rephone</groupId>
            <artifactId>rephone-wechat</artifactId>
        </dependency>
        <dependency>
            <groupId>com.rephone</groupId>
            <artifactId>rephone-express</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 测试：H2 内存库承载集成测试，无需本机 MySQL 也能验证登录闭环 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>rephone-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
