/* TDesign 组件主题覆盖（RePhone v5 炭黑 + 赤陶体系）

   注意 1：miniprogram_npm 未被 git 跟踪（npm 构建产物），组件主题只能在这里覆盖。
   注意 2：TDesign 组件用的是默认样式隔离（没有 addGlobalClass / styleIsolation），
           app.wxss 里 `.t-button { --td-* }` 这类类名选择器**匹配不到组件内部**，
           写在那里的覆盖全部无效 —— 组件会一路回退到 TDesign 默认蓝 #0052D9。
           唯一有效的做法是把变量声明在 `page` 上：CSS 自定义属性是「计算值继承」，
           不受样式隔离影响，会一路继承进组件内部。
   注意 3：色值一律引用 design-tokens 的令牌，不要硬编码。 */
page {
  /* ---------- 调色板根变量（按钮 / 标签 / 选项卡 / 步骤条 / 开关 等自动跟随） ---------- */
  --td-brand-color: var(--brand);
  --td-brand-color-light: var(--brand-light);
  --td-brand-color-light-active: var(--brand-light);
  --td-brand-color-active: var(--brand-deep);
  --td-brand-color-disabled: var(--line-strong);
  --td-text-color-brand: var(--brand);
  --td-text-color-anti: var(--text-anti);
  --td-success-color: var(--success);
  --td-warning-color: var(--warning);
  --td-error-color: var(--danger);

  /* ---------- 按钮 ---------- */
  --td-button-font-weight: 500;
  --td-button-medium-font-size: 32rpx;
  /* theme="default"（实心主按钮） */
  --td-button-default-color: var(--text-anti);
  --td-button-default-bg-color: var(--brand);
  --td-button-default-border-color: var(--brand);
  --td-button-default-active-bg-color: var(--brand-deep);
  --td-button-default-active-border-color: var(--brand-deep);
  --td-button-default-disabled-color: var(--text-anti);
  --td-button-default-disabled-bg: var(--line-strong);
  --td-button-default-disabled-border-color: var(--line-strong);
  /* theme="primary" */
  --td-button-primary-color: var(--text-anti);
  --td-button-primary-bg-color: var(--brand);
  --td-button-primary-border-color: var(--brand);
  --td-button-primary-active-bg-color: var(--brand-deep);
  --td-button-primary-active-border-color: var(--brand-deep);
  --td-button-primary-disabled-color: var(--text-anti);
  --td-button-primary-disabled-bg: var(--line-strong);
  --td-button-primary-disabled-border-color: var(--line-strong);
  /* theme="danger" */
  --td-button-danger-bg-color: var(--danger);
  --td-button-danger-border-color: var(--danger);
  --td-button-danger-active-bg-color: var(--danger-deep);
  --td-button-danger-active-border-color: var(--danger-deep);

  /* ---------- 标签 ---------- */
  --td-tag-primary-color: var(--brand);
  --td-tag-primary-light-color: var(--brand-light);
  --td-tag-success-color: var(--success);
  --td-tag-success-light-color: var(--success-light);
  --td-tag-warning-color: var(--warning);
  --td-tag-warning-light-color: var(--warning-light);
  --td-tag-danger-color: var(--danger);
  --td-tag-danger-light-color: var(--danger-light);
  --td-tag-default-color: var(--text-2);
  --td-tag-default-light-color: var(--bg-sunken);

  /* ---------- 选项卡（订单列表） ---------- */
  --td-tab-item-active-color: var(--brand);
  --td-tab-item-tag-active-bg: var(--brand-light);

  /* ---------- 单元格 ---------- */
  --td-cell-left-icon-color: var(--brand);
  --td-cell-right-icon-color: var(--text-3);

  /* ---------- 步骤条（订单时间线） ---------- */
  --td-step-item-process-circle-color: var(--brand);
  --td-step-item-process-dot-border-color: var(--brand);
  --td-step-item-finish-circle-color: var(--brand);
  --td-step-item-finish-dot-border-color: var(--brand);
  --td-step-item-finish-line-color: var(--brand);

  /* ---------- 表单类 ---------- */
  --td-switch-checked-color: var(--brand);
  --td-checkbox-icon-checked-color: var(--brand);
  --td-radio-icon-checked-color: var(--brand);
  --td-radio-label-checked-color: var(--brand);
  --td-picker-confirm-color: var(--brand);
  --td-stepper-border-color: var(--line-strong);
  --td-input-text-color: var(--text-1);
  --td-input-placeholder-text-color: var(--text-3);
  --td-textarea-placeholder-color: var(--text-3);
  --td-cascader-active-color: var(--brand);
}

/* ---------- 弹窗按钮 ---------- */
.dialog__button-confirm {
  color: var(--brand) !important;
}

.dialog__button-cancel {
  color: var(--text-3) !important;
}
