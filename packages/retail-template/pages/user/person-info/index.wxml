<view class="person-info">
  <t-cell-group>
    <t-cell
      title="头像"
      center="{{true}}"
      data-type="avatarUrl"
      bind:click="onClickCell"
      arrow
      t-class-left="order-group__left"
    >
      <t-image slot="note" src="{{personInfo.avatarUrl}}" t-class="avatarUrl" mode="aspectFill" />
    </t-cell>
    <t-cell
      title="昵称"
      arrow
      note="{{personInfo.nickName}}"
      data-type="name"
      bind:click="onClickCell"
      t-class="t-cell-class"
      t-class-left="order-group__left"
    />
    <t-cell
      title="性别"
      arrow
      note="{{genderMap[personInfo.gender]}}"
      data-type="gender"
      bind:click="onClickCell"
      t-class="t-cell-class"
      t-class-left="order-group__left"
    />
    <t-cell
      bordered="{{false}}"
      title="手机号"
      arrow
      note="{{personInfo.phoneNumber ? personInfo.phoneNumber : '去绑定手机号'}}"
      data-type="phoneNumber"
      bind:click="onClickCell"
      t-class="t-cell-class"
      t-class-left="order-group__left"
    />
  </t-cell-group>
</view>
<view class="person-info__wrapper">
  <view class="person-info__btn" bind:tap="openUnbindConfirm"> 切换账号登录 </view>
</view>
<t-select-picker
  show="{{typeVisible}}"
  picker-options="{{pickerOptions}}"
  title="选择性别"
  value="{{personInfo.gender}}"
  bind:confirm="onConfirm"
  bind:close="onClose"
/>

<!-- 手机号绑定：半屏输入（真实短信验证留二期，先人工填写） -->
<t-popup visible="{{phoneSheetVisible}}" placement="bottom" bind:visible-change="hidePhoneSheet">
  <view class="phone-sheet">
    <view class="phone-sheet__title">{{personInfo.phoneNumber ? '更换绑定手机号' : '绑定手机号'}}</view>
    <view class="phone-sheet__hint">输入新手机号保存即换绑；什么都不填直接保存 = 解绑当前号码</view>
    <t-input
      label="手机号"
      type="number"
      maxlength="11"
      placeholder="11 位手机号"
      value="{{phoneInput}}"
      bindchange="onPhoneInput"
    />
    <t-button theme="primary" block bindtap="onPhoneSave">
      {{phoneInput ? '保存' : '解绑手机号'}}
    </t-button>
  </view>
</t-popup>

<!-- 切换账号登录确认 -->
<t-dialog
  visible="{{showUnbindConfirm}}"
  title="切换账号登录"
  content="将清除本地登录状态并重新登录，确认继续？"
  confirm-btn="切换"
  cancel-btn="取消"
  bind:confirm="onUnbindConfirm"
  bind:close="onUnbindClose"
/>
<t-toast id="t-toast" />
