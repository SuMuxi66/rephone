:host {
  background-color: var(--bg-page);
}
.page-container .tab-bar__placeholder,
.page-container .tab-bar__inner {
  height: 88rpx;
  line-height: 88rpx;
  background: var(--bg-card);
}
.page-container .tab-bar__inner {
  font-size: 26rpx;
  color: var(--text-1);
  position: fixed;
  width: 100vw;
  top: 0;
  left: 0;
}
.page-container .tab-bar__inner.order-nav .order-nav-item .bottom-line {
  bottom: 12rpx;
}
.tab-bar__inner .t-tabs-is-active {
  color: var(--brand) !important;
}

.tab-bar__inner .t-tabs-track {
  background: var(--brand) !important;
}

.page-container .tab-bar__active {
  font-size: 28rpx;
}
.page-container .specs-popup .bottom-btn {
  color: var(--brand);
  color: var(--color-primary, var(--brand));
}
.page-container .specs-popup .bottom-btn::after {
  border-color: var(--brand);
  border-color: var(--color-primary, var(--brand));
}
.dialog .dialog__button-confirm {
  color: var(--brand);
  color: var(--color-primary, var(--brand));
}
.list-loading {
  height: 100rpx;
}
.empty-wrapper {
  height: calc(100vh - 88rpx);
}
.btn-bar {
  margin-top: 20rpx;
}
.load-more {
  margin: 0 24rpx;
}
wr-order-goods-card:not(:first-child) .wr-goods-card {
  margin-top: 40rpx;
}

.price-total {
  font-size: 24rpx;
  line-height: 32rpx;
  color: var(--text-3);
  padding-top: 10rpx;
  width: 100%;
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
}
.price-total .bold-price {
  color: var(--text-1);
  font-size: 28rpx;
  line-height: 40rpx;
  color: var(--text-1);
}
.price-total .real-pay {
  font-size: 36rpx;
  line-height: 48rpx;
  color: var(--brand);
  font-weight: bold;
}

.t-tabs.t-tabs--top .t-tabs-scroll {
  border: none !important;
}
.t-empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

.page-container .order-number {
  color: var(--text-2);
  font-size: 28rpx;
}
.t-class-indicator {
  color: var(--text-3) !important;
}
.tab-bar .tab-bar__active {
  color: var(--text-1) !important;
}

.tab-bar .t-tabs-track {
  background: var(--text-1) !important;
}

.t-button {
  --td-button-default-color: var(--text-1);
  --td-button-primary-text-color: var(--brand);
}
