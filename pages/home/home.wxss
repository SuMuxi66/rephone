.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
}

.hero {
  margin: var(--space-page);
  padding: 72rpx 48rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--brand), #ff8a4c);
  color: #fff;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.hero-cta {
  display: inline-block;
  margin-top: 28rpx;
  padding: 14rpx 40rpx;
  border-radius: 36rpx;
  background: #fff;
  color: var(--brand);
  font-size: 28rpx;
  font-weight: 600;
}

.entries {
  display: flex;
  margin: 0 var(--space-page);
  padding: 28rpx 0;
  background: var(--bg-card);
  border-radius: var(--radius-card);
}

.entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  color: var(--text-1);
}

.entry-name {
  font-size: 26rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 36rpx var(--space-page) 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-3);
}

.models {
  white-space: nowrap;
  padding: 0 var(--space-page);
}

.model-card {
  display: inline-block;
  width: 240rpx;
  margin-right: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: var(--radius-card);
  background: var(--bg-card);
  vertical-align: top;
}

.model-img {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 12rpx;
}

/* 无图占位：CSS 手机轮廓（与估价页弹层同款） */
.model-ph {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f6f8;
  border-radius: 12rpx;
}

.model-ph-body {
  width: 56rpx;
  height: 100rpx;
  border: 5rpx solid #c9cdd4;
  border-radius: 12rpx;
  position: relative;
  background: #fff;
}

.model-ph-camera {
  position: absolute;
  top: 6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #c9cdd4;
}

.model-brand {
  font-size: 22rpx;
  color: var(--text-3);
}

.model-name {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
}

.model-price {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--money);
}

.flow {
  display: flex;
  margin: 0 var(--space-page);
  padding: 32rpx 12rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
}

.flow-step {
  flex: 1;
  text-align: center;
}

.flow-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 700;
}

.flow-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-1);
}

.flow-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

/* ===== 维修主导改版（2026-09-29） ===== */
.hero--secondary {
  padding: 40rpx 48rpx;
  background: var(--bg-card);
  border: 2rpx solid var(--brand-light);
  color: var(--text-1);
}

.hero--secondary .hero-title {
  font-size: 36rpx;
  color: var(--text-1);
}

.hero--secondary .hero-sub {
  color: var(--text-3);
  opacity: 1;
}

.hero--secondary .hero-cta {
  background: var(--brand);
  color: #fff;
}

.repair-chip {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 32rpx;
  margin-right: 20rpx;
  border-radius: 36rpx;
  background: var(--bg-card);
  color: var(--text-1);
  font-size: 28rpx;
  font-weight: 500;
}
