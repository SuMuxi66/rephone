/* 首页 v5（专业二手机交易平台）：科技蓝 + 橙强调 + 浅灰底 */
.page {
  min-height: 100vh;
  background: var(--bg-page);
  /* 自定义 tabBar 为底部浮层，预留其高度 + 安全区，否则最后一段滚不出来 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
}

/* ===== 搜索栏 ===== */
.searchbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx var(--space-page) 0;
  padding: 18rpx 24rpx;
  background: var(--bg-card);
  border-radius: 999rpx;
  border: 2rpx solid var(--border-light);
}

.searchbar-text {
  font-size: 26rpx;
  color: var(--text-3);
}

/* ===== 信任条 ===== */
.trustbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx var(--space-page) 0;
  padding: 14rpx 24rpx;
  background: var(--brand-light);
  border-radius: var(--radius-card);
}

.trust-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--brand-deep);
}

/* ===== Banner 轮播 ===== */
.banner {
  height: 260rpx;
  margin: 20rpx var(--space-page) 0;
  border-radius: var(--radius-card);
  overflow: hidden;
}

.banner-item {
  position: relative;
  overflow: hidden;
}

.banner--accent {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-deep) 100%);
}

.banner--deep {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
}

.banner--brand {
  background: linear-gradient(135deg, #2F6FF0 0%, var(--brand-deep) 100%);
}

.banner-body {
  position: relative;
  z-index: 1;
  padding: 44rpx 40rpx;
  color: #FFFFFF;
}

.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.banner-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.banner-cta {
  display: inline-block;
  margin-top: 20rpx;
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-1);
  background: #FFFFFF;
  border-radius: 999rpx;
}

/* 装饰圆环（纯 CSS，无图片依赖） */
.banner-deco {
  position: absolute;
  right: -60rpx;
  top: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  opacity: 0.16;
  background: #FFFFFF;
}

.banner-deco::after {
  content: '';
  position: absolute;
  right: 40rpx;
  top: 120rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #FFFFFF;
  opacity: 0.6;
  background: transparent;
}

/* ===== 三大业务入口 ===== */
.entries {
  display: flex;
  gap: 16rpx;
  margin: 20rpx var(--space-page) 0;
}

.entry-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 12rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: 2rpx solid var(--border-light);
}

.entry-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-icon--accent {
  background: var(--accent);
}

.entry-icon--deep {
  background: var(--brand-deep);
}

.entry-icon--brand {
  background: var(--brand);
}

.entry-name {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}

.entry-sub {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-3);
  text-align: center;
}

.entry-btn {
  margin-top: 18rpx;
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.entry-btn--accent {
  color: var(--accent);
  background: var(--accent-light);
}

.entry-btn--deep {
  color: var(--brand-deep);
  background: var(--brand-light);
}

.entry-btn--brand {
  color: var(--brand);
  background: var(--brand-light);
}

/* ===== 通用区块 ===== */
.block {
  margin: 32rpx var(--space-page) 0;
}

.block-head {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.block-head-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.block-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
}

.block-note {
  font-size: 22rpx;
  color: var(--text-3);
}

.block-more {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--text-2);
}

/* ===== 严选好机：主推大卡 ===== */
.feat {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: 2rpx solid var(--border-light);
  overflow: hidden;
}

.feat-img {
  position: relative;
  width: 260rpx;
  height: 260rpx;
  flex-shrink: 0;
}

.feat-photo {
  width: 100%;
  height: 100%;
}

/* 无图占位：CSS 手机轮廓 */
.dev {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-page);
}

.dev::before {
  content: '';
  width: 88rpx;
  height: 160rpx;
  border: 6rpx solid var(--line-strong);
  border-radius: 18rpx;
  background: var(--bg-card);
}

.feat-badge {
  position: absolute;
  left: 0;
  top: 0;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: var(--brand);
  border-radius: 0 0 var(--radius-card) 0;
}

.feat-body {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.feat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.35;
}

.spec {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.spec-chip {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  color: var(--text-2);
  background: var(--bg-page);
  border-radius: 8rpx;
}

.spec-chip--ok {
  color: var(--brand);
  background: var(--brand-light);
}

.price-row {
  margin-top: auto;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--money);
}

.price-old {
  font-size: 22rpx;
  color: var(--text-3);
  text-decoration: line-through;
}

.price-cta {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
}

/* ===== 严选好机：紧凑列表 ===== */
.mini-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mini {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: 2rpx solid var(--border-light);
}

.mini-thumb-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.mini-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-page);
}

.dev-s::before {
  content: '';
  display: block;
  width: 44rpx;
  height: 80rpx;
  border: 4rpx solid var(--line-strong);
  border-radius: 10rpx;
  background: var(--bg-card);
}

.mini-main {
  flex: 1;
  min-width: 0;
}

.mini-name {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-spec {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.mini-chip {
  padding: 2rpx 12rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 8rpx;
  font-size: 19rpx;
}

.mini-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.mini-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--money);
}

.mini-price-old {
  font-size: 20rpx;
  color: var(--text-3);
  text-decoration: line-through;
}

/* ===== 回收行情 ===== */
.quote {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  border: 2rpx solid var(--border-light);
  padding: 8rpx 24rpx;
}

.quote-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--border-light);
}

.quote-row:last-of-type {
  border-bottom: none;
}

.quote-brand {
  flex-shrink: 0;
  padding: 2rpx 14rpx;
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-light);
  border-radius: 8rpx;
}

.quote-name {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quote-cap {
  font-size: 20rpx;
  color: var(--text-3);
}

.quote-val {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--money);
}

.quote-foot {
  padding: 20rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: var(--brand);
  border-top: 2rpx solid var(--border-light);
}

/* ===== 底部信任栏（简化） ===== */
.assure {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.assure-item {
  font-size: 22rpx;
  color: var(--text-2);
}

.assure-dot {
  color: var(--text-3);
}

.foot {
  margin-top: 12rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-3);
  letter-spacing: 2rpx;
}

.loading-wrap {
  padding: 160rpx 0;
  display: flex;
  justify-content: center;
}
