/* 首页 v5：炭黑 + 赤陶 / 克制排版
   规范：字号只用 5 档（44 / 32 / 28 / 24 / 20 rpx）
        圆角只用 3 种（--radius-card / --radius-sm / --radius-pill）
   设计稿：docs/design/2026-10-01-home-palette-c.html */
.page {
  min-height: 100vh;
  background: var(--bg-page);
  /* 自定义 tabBar 为底部浮层，预留其高度 + 安全区，否则最后一段滚不出来 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
}

/* ===== 搜索栏 ===== */
.searchbar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx var(--space-page) 0;
  padding: 18rpx 26rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-sunken);
  color: var(--text-3);
}

.searchbar-text {
  font-size: 24rpx;
}

/* ===== 平台承诺：一行纯文字，无容器无图标 ===== */
.trust {
  margin-top: 18rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}

/* ===== Banner：纯色底 + 几何圆 ===== */
.banner {
  height: 280rpx;
  margin: 24rpx var(--space-page) 0;
  border-radius: var(--radius-card);
  overflow: hidden;
}

.banner-item {
  position: relative;
  overflow: hidden;
}

.banner--accent {
  background: var(--accent);
}

.banner--brand {
  background: var(--brand);
}

.banner--deep {
  background: var(--brand-deep);
}

.banner-circle {
  position: absolute;
  right: -100rpx;
  top: -112rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.banner-circle--sm {
  right: -28rpx;
  top: 92rpx;
  width: 156rpx;
  height: 156rpx;
  background: rgba(255, 255, 255, 0.05);
}

.banner-body {
  position: relative;
  z-index: 1;
  padding: 40rpx;
  color: var(--text-anti);
}

.banner-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.banner-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.82;
}

.banner-cta {
  display: inline-block;
  margin-top: 24rpx;
  padding: 12rpx 30rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-card);
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 业务入口：1 大 2 小 ===== */
.sellrow {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx var(--space-page) 0;
  padding: 24rpx;
  border-radius: var(--radius-card);
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
}

.sellrow-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--bg-sunken);
  color: var(--brand);
}

.sellrow-text {
  flex: 1;
  min-width: 0;
}

.sellrow-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.sellrow-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.sellrow-btn {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: var(--radius-pill);
  background: var(--brand);
  color: var(--text-anti);
  font-size: 24rpx;
  font-weight: 600;
}

.two {
  display: flex;
  gap: 20rpx;
  margin: 16rpx var(--space-page) 0;
}

.tcard {
  flex: 1;
  padding: 24rpx;
  border-radius: var(--radius-card);
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
}

.tcard-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-card);
  background: var(--bg-sunken);
  color: var(--brand);
}

.tcard-name {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.tcard-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

/* ===== 区块头 ===== */
.block {
  margin: 40rpx var(--space-page) 0;
}

.block-head {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.block-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}

.block-note {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.block-more {
  margin-left: auto;
  font-size: 20rpx;
  color: var(--text-3);
}

/* ===== 严选好机：主推 ===== */
.feat {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-card);
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
}

.feat-img {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  overflow: hidden;
  background: var(--bg-sunken);
}

.feat-photo {
  width: 100%;
  height: 100%;
}

/* 无图占位：CSS 手机轮廓 */
.dev {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dev::before {
  content: '';
  width: 64rpx;
  height: 118rpx;
  border: 5rpx solid var(--line-strong);
  border-radius: var(--radius-card);
  opacity: 0.55;
}

.feat-badge {
  position: absolute;
  left: 0;
  top: 0;
  padding: 4rpx 12rpx;
  border-radius: 0 0 var(--radius-sm) 0;
  background: var(--brand);
  color: var(--text-anti);
  font-size: 20rpx;
  font-weight: 600;
}

.feat-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.feat-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-1);
  line-height: 1.45;
}

.spec {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.chip {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-sunken);
  color: var(--text-2);
  font-size: 20rpx;
}

.price-row {
  margin-top: auto;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.price {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--money);
}

.price-old {
  font-size: 20rpx;
  color: var(--text-3);
  text-decoration: line-through;
}

/* ===== 严选好机：紧凑行 ===== */
.mini-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.mini {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border-radius: var(--radius-card);
  background: var(--bg-card);
  border: 2rpx solid var(--border-light);
}

.mini-thumb-img,
.mini-thumb {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: var(--radius-sm);
  background: var(--bg-sunken);
}

.mini-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
}

.dev-s::before {
  content: '';
  display: block;
  width: 32rpx;
  height: 58rpx;
  border: 4rpx solid var(--line-strong);
  border-radius: var(--radius-sm);
  opacity: 0.55;
}

.mini-main {
  flex: 1;
  min-width: 0;
}

.mini-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-spec {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.mini-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.mini-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--money);
}

.mini-price-old {
  font-size: 20rpx;
  color: var(--text-3);
  text-decoration: line-through;
}

/* ===== 回收行情：纯文字 + 发丝线，无卡片 ===== */
.quote {
  margin-top: 4rpx;
}

.quote-row {
  display: flex;
  align-items: baseline;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--border-light);
}

.quote-brand {
  flex-shrink: 0;
  width: 76rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.quote-name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quote-cap {
  font-size: 20rpx;
  color: var(--text-3);
}

.quote-val {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--money);
}

.quote-foot {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--brand);
}

/* ===== 页脚 ===== */
.foot {
  margin: 56rpx 0 24rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--text-3);
  letter-spacing: 6rpx;
}

.loading-wrap {
  padding: 160rpx 0;
  display: flex;
  justify-content: center;
}
