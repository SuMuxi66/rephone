<view class="page" wx:if="{{!pageLoading}}">
  <!-- 主横幅：回收入口 -->
  <view class="hero" bindtap="goEstimate">
    <view class="hero-title">旧机回收 · 高价秒估</view>
    <view class="hero-sub">顺丰包邮 / 上门取件 · 质检后快速打款</view>
    <view class="hero-cta">立即免费估价</view>
  </view>

  <!-- 流程三入口 -->
  <view class="entries">
    <view class="entry" bindtap="goEstimate">
      <t-icon prefix="wr" name="search" size="52rpx" />
      <view class="entry-name">在线估价</view>
    </view>
    <view class="entry" bindtap="goEstimate">
      <t-icon prefix="wr" name="deliver" size="52rpx" />
      <view class="entry-name">顺丰包邮</view>
    </view>
    <view class="entry" bindtap="goEstimate">
      <t-icon prefix="wr" name="wallet" size="52rpx" />
      <view class="entry-name">质检打款</view>
    </view>
  </view>

  <!-- 热门机型 -->
  <view class="section-head">
    <text class="section-title">热门机型</text>
    <text class="section-more" bindtap="goEstimate">更多</text>
  </view>
  <scroll-view scroll-x class="models" enhanced show-scrollbar="{{false}}">
    <view
      wx:for="{{hotModels}}"
      wx:key="modelName"
      class="model-card"
      data-brand-id="{{item.brandId}}"
      bindtap="goEstimateWithBrand"
    >
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" class="model-img" lazy-load />
      <view wx:else class="model-ph">
        <view class="model-ph-body"><view class="model-ph-camera"></view></view>
      </view>
      <view class="model-brand">{{item.brandName}}</view>
      <view class="model-name">{{item.modelName}}</view>
      <view class="model-price">最高 {{item.priceText}}</view>
    </view>
  </scroll-view>

  <!-- 回收流程 -->
  <view class="section-head">
    <text class="section-title">回收流程</text>
  </view>
  <view class="flow">
    <view class="flow-step" wx:for="{{flowSteps}}" wx:key="step">
      <view class="flow-no">{{item.step}}</view>
      <view class="flow-name">{{item.name}}</view>
      <view class="flow-desc">{{item.desc}}</view>
    </view>
  </view>
</view>

<view wx:if="{{pageLoading}}" style="text-align: center; color: #b9b9b9; padding-top: 200rpx">
  <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
</view>
