<view class="page" wx:if="{{!pageLoading}}">
  <!-- 搜索栏 -->
  <view class="searchbar" bindtap="goSale">
    <t-icon name="search" size="28rpx" />
    <text class="searchbar-text">搜索品牌 / 型号 / 成色</text>
  </view>

  <!-- 平台承诺：一行纯文字，不用容器、不用图标 -->
  <view class="trust">{{trustLine}}</view>

  <!-- Banner：纯色底 + 几何圆，不用 135° 渐变 -->
  <swiper
    class="banner"
    indicator-dots
    indicator-color="rgba(255,255,255,0.35)"
    indicator-active-color="rgba(255,255,255,0.95)"
    autoplay
    circular
    interval="4500"
  >
    <swiper-item
      wx:for="{{banners}}"
      wx:key="key"
      class="banner-item banner--{{item.theme}}"
      bindtap="{{item.tap}}"
    >
      <view class="banner-circle"></view>
      <view class="banner-circle banner-circle--sm"></view>
      <view class="banner-body">
        <view class="banner-title">{{item.title}}</view>
        <view class="banner-sub">{{item.sub}}</view>
        <view class="banner-cta">{{item.cta}}</view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 业务入口：1 大 2 小 -->
  <view
    wx:if="{{entries.length}}"
    class="sellrow"
    bindtap="{{entries[0].tap}}"
  >
    <view class="sellrow-icon">
      <t-icon name="{{entries[0].icon}}" size="40rpx" />
    </view>
    <view class="sellrow-text">
      <view class="sellrow-name">{{entries[0].name}}</view>
      <view class="sellrow-sub">{{entries[0].sub}}</view>
    </view>
    <view class="sellrow-btn">{{entries[0].btn}}</view>
  </view>
  <view class="two" wx:if="{{entriesMore.length}}">
    <view
      wx:for="{{entriesMore}}"
      wx:key="key"
      class="tcard"
      bindtap="{{item.tap}}"
    >
      <view class="tcard-icon">
        <t-icon name="{{item.icon}}" size="34rpx" />
      </view>
      <view class="tcard-name">{{item.name}}</view>
      <view class="tcard-sub">{{item.sub}}</view>
    </view>
  </view>

  <!-- 严选好机：1 张主推 + 2 行紧凑列表（无库存时整块隐藏） -->
  <view class="block" wx:if="{{featured}}">
    <view class="block-head">
      <text class="block-title">严选好机</text>
      <text class="block-note">一机一报告</text>
      <text class="block-more" bindtap="goSale">全部 ›</text>
    </view>
    <view class="feat" data-id="{{featured.id}}" bindtap="goGoodsDetail">
      <view class="feat-img">
        <image wx:if="{{featured.image}}" class="feat-photo" src="{{featured.image}}" mode="aspectFill" />
        <view wx:else class="dev"></view>
        <view class="feat-badge">官方质检</view>
      </view>
      <view class="feat-body">
        <view class="feat-name">{{featured.name}}</view>
        <view class="spec">
          <text wx:if="{{featured.conditionLevel}}" class="chip">{{featured.conditionLevel}}</text>
          <text wx:if="{{featured.storage}}" class="chip">{{featured.storage}}</text>
          <text wx:for="{{featured.tagTop}}" wx:key="*this" class="chip">{{item}}</text>
        </view>
        <view class="price-row">
          <text class="price">¥{{featured.priceText}}</text>
          <text wx:if="{{featured.originText}}" class="price-old">¥{{featured.originText}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{featuredMore.length}}" class="mini-list">
      <view wx:for="{{featuredMore}}" wx:key="id" class="mini" data-id="{{item.id}}" bindtap="goGoodsDetail">
        <image wx:if="{{item.image}}" class="mini-thumb-img" src="{{item.image}}" mode="aspectFill" />
        <view wx:else class="mini-thumb"><view class="dev-s"></view></view>
        <view class="mini-main">
          <view class="mini-name">{{item.name}}</view>
          <view class="mini-spec">{{item.specText}}</view>
        </view>
        <view class="mini-right">
          <text class="mini-price">¥{{item.priceText}}</text>
          <text wx:if="{{item.originText}}" class="mini-price-old">¥{{item.originText}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 回收行情：纯文字 + 发丝线，去掉卡片容器（后端已滤零价并按价降序） -->
  <view class="block" wx:if="{{hotModels.length}}">
    <view class="block-head">
      <text class="block-title">回收行情</text>
      <text class="block-more" bindtap="goEstimate">更多机型 ›</text>
    </view>
    <view class="quote">
      <view
        wx:for="{{hotModels}}"
        wx:key="modelName"
        class="quote-row"
        data-brand-id="{{item.brandId}}"
        bindtap="goEstimateWithBrand"
      >
        <text class="quote-brand">{{item.brandName}}</text>
        <text class="quote-name">{{item.modelName}}</text>
        <text class="quote-cap">最高</text>
        <text class="quote-val">{{item.priceText}}</text>
      </view>
      <view class="quote-foot" bindtap="goEstimate">输入你的机型，30 秒出准确报价</view>
    </view>
  </view>

  <view class="foot">REPHONE</view>
</view>

<view wx:if="{{pageLoading}}" class="loading-wrap">
  <t-loading theme="circular" size="40rpx" text="加载中..." inherit-color />
</view>
