.user-center-card {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 480rpx;
  /* 原为 TDesign 模板的远程粉红背景图（tdesign.gtimg.com/miniprogram/template/...）：
     既不是本仓库资产、又依赖第三方 CDN（断网即白块，且外泄用户 IP），
     且粉红色与炭黑 + 赤陶色板冲突。改为令牌纯色底。 */
  background: var(--brand);
  overflow: hidden;
  padding: 0 24rpx;
}

/* 与首页 banner 同语言的几何圆，给纯色底一点层次 */
.user-center-card::after {
  content: '';
  position: absolute;
  right: -140rpx;
  top: -160rpx;
  width: 460rpx;
  height: 460rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.user-center-card__header {
  margin-top: 192rpx;
  margin-bottom: 48rpx;
  height: 96rpx;
  line-height: 48rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  color: var(--text-anti);
  position: relative;
  z-index: 1;
}

.user-center-card__header__avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  overflow: hidden;
}

.user-center-card__header__name {
  font-size: 36rpx;
  line-height: 48rpx;
  color: var(--text-anti);
  font-weight: bold;
  margin-left: 24rpx;
  margin-right: 16rpx;
}

.user-center-card__header__transparent {
  position: absolute;
  left: 0;
  top: 0;
  background-color: transparent;
  height: 100%;
  width: 100%;
}

.user-center-card__icon {
  line-height: 96rpx;
}
