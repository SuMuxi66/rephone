.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding: var(--space-page);
  box-sizing: border-box;
}

.order-card {
  background: linear-gradient(135deg, var(--brand-light), var(--bg-card));
  border-radius: var(--radius-card);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
}

.order-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.order-no {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  padding: 32rpx;
}

.done-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.done-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.done-content {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--text-2);
  line-height: 1.6;
}

.done-hint {
  margin: 24rpx 0;
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
}

.score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.score-label {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.field-label {
  font-size: 26rpx;
  color: var(--text-2);
  margin: 24rpx 0 12rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.photo-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-sm);
  background: var(--bg-sunken);
}

.photo-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-pill);
  background: var(--danger);
  color: var(--text-anti);
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--line-strong);
  border-radius: var(--radius-sm);
  color: var(--text-3);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
