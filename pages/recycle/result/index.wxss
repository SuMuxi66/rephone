.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 60rpx;
}

.price-card {
  margin: var(--space-page);
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--brand-light), var(--bg-card));
  text-align: center;
}

.price-label {
  font-size: 28rpx;
  color: var(--text-2);
}

.price-row {
  margin-top: 16rpx;
  color: var(--money);
}

.price-symbol {
  font-size: 40rpx;
  margin-right: 8rpx;
}

.price-value {
  font-size: 88rpx;
  font-weight: 700;
}

.price-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.footer {
  display: flex;
  gap: 24rpx;
  padding: 48rpx 32rpx 0;
}
