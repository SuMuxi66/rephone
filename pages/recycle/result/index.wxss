.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: 60rpx;
}

.price-card {
  margin: 24rpx;
  padding: 60rpx 40rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fff7f0, #fff);
  text-align: center;
}

.price-label {
  font-size: 28rpx;
  color: #666;
}

.price-row {
  margin-top: 16rpx;
  color: #ff5f15;
}

.price-symbol {
  font-size: 40rpx;
  margin-right: 8rpx;
}

.price-value {
  font-size: 88rpx;
  font-weight: 700;
}

.price-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.footer {
  display: flex;
  gap: 24rpx;
  padding: 48rpx 32rpx 0;
}
