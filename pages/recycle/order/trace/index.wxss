.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 60rpx;
}

.state {
  padding: 160rpx 48rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: var(--text-2);
}

.state-retry {
  margin: 32rpx auto 0;
  width: 220rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  color: var(--brand);
  border: 1rpx solid var(--brand);
}

.head {
  position: relative;
  margin: var(--space-page);
  padding: 36rpx;
  border-radius: var(--radius-card);
  background: linear-gradient(135deg, var(--brand-deep), var(--brand));
}

.head-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.head-state {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.head-badge {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.24);
}

.head-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
}

.head-copy {
  position: absolute;
  right: 36rpx;
  bottom: 36rpx;
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  font-size: 22rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.timeline {
  margin: 0 var(--space-page);
  padding: 12rpx 28rpx;
  border-radius: var(--radius-card);
  background: var(--bg-card);
}

.node {
  display: flex;
  padding-top: 28rpx;
}

.node-rail {
  width: 40rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.node-dot {
  margin-top: 8rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--line-strong);
}

.node--active .node-dot {
  width: 20rpx;
  height: 20rpx;
  margin-top: 5rpx;
  background: var(--brand);
}

.node-line {
  flex: 1;
  width: 2rpx;
  margin-top: 6rpx;
  background: var(--border-light);
}

.node-body {
  flex: 1;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.node:last-child .node-body {
  border-bottom: none;
}

.node-context {
  font-size: 28rpx;
  line-height: 42rpx;
  color: var(--text-2);
}

.node--active .node-context {
  color: var(--text-1);
  font-weight: 600;
}

.node-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.foot {
  padding: 32rpx 48rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
}
