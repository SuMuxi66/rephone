.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 60rpx;
}

.steps-wrap {
  padding: 24rpx var(--space-page) 8rpx;
}

.state {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.state-text {
  color: var(--text-3);
  font-size: 28rpx;
}

.option-list {
  padding: 0 16rpx;
}

.option-list-plain {
  padding: 0 16rpx;
}

.footer {
  padding: 48rpx 32rpx 0;
}

.footer-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
