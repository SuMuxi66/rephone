.page {
  min-height: 100vh;
  background: var(--bg-page);
  /* 页面是自定义 tabBar 页：tabBar 为底部浮层，内容需让出其高度才能完整滑到底 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
}

.steps-wrap {
  padding: 24rpx var(--space-page) 8rpx;
}

.state {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.state-text {
  color: var(--text-3);
  font-size: 28rpx;
}

.option-list {
  padding: 0 16rpx;
}

.option-list-plain {
  padding: 0 16rpx;
}

.issue-group {
  margin-bottom: 8rpx;
}

.issue-group-title {
  padding: 24rpx 16rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
}

.footer {
  padding: 48rpx 32rpx 0;
}

.footer-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
