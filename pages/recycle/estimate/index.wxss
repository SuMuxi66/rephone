.page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: 60rpx;
}

.state {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.state-text {
  color: #999;
  font-size: 28rpx;
}

.section-title {
  padding: 32rpx 32rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.option-list {
  background: #fff;
  margin: 16rpx 24rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
}

.footer {
  padding: 48rpx 32rpx 0;
}

.footer-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}
