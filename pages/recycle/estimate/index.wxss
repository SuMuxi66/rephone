.page {
  min-height: 100vh;
  background: var(--bg-page);
  /* 页面是自定义 tabBar 页：tabBar 为底部浮层，内容需让出其高度才能完整滑到底 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
}

.steps-wrap {
  padding: 24rpx var(--space-page) 8rpx;
}

.state {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.state-text {
  color: var(--text-3);
  font-size: 28rpx;
}

/* ===== 分步问题卡片（答完一题渐显下一题） ===== */
.q-card {
  background: var(--bg-card);
  border-radius: var(--radius-card);
  margin: 20rpx var(--space-page) 0;
  padding: 8rpx 0 24rpx;
}

.q-head {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
}

.q-no {
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--brand);
  color: var(--bg-card);
  font-size: 24rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.q-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.q-picked {
  margin-left: auto;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand);
}

.q-tip {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 内存 / 功能问题 chip */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
}

.chip {
  padding: 14rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  border: 2rpx solid var(--border-light);
  background: var(--bg-card);
  color: var(--text-1);
  font-size: 26rpx;
}

.chip.active {
  border-color: var(--brand);
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 600;
}

/* 成色 / 屏幕状态说明卡 */
.desc-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.desc-card {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid var(--border-light);
  border-radius: var(--radius-card);
  background: var(--bg-card);
  box-sizing: border-box;
}

.desc-card.active {
  border-color: var(--brand);
  background: var(--brand-light);
}

.desc-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.desc-card.active .desc-label {
  color: var(--brand);
}

.desc-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.4;
}

/* 功能问题分组 */
.issue-group {
  margin-bottom: 8rpx;
}

.issue-group-title {
  padding: 16rpx 24rpx 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
}

.footer {
  padding: 48rpx 32rpx 0;
}

.footer-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
