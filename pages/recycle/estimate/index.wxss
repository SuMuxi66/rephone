.page {
  min-height: 100vh;
  background: var(--bg-page);
  /* 页面是自定义 tabBar 页：tabBar 为底部浮层，内容需让出其高度才能完整滑到底 */
  padding-bottom: calc(env(safe-area-inset-bottom) + 160rpx);
}

.steps-wrap {
  padding: 24rpx var(--space-page) 8rpx;
}

.state {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.state-text {
  color: var(--text-3);
  font-size: 28rpx;
}

.option-list {
  padding: 0 16rpx;
}

.option-list-plain {
  padding: 0 16rpx;
}

.issue-group {
  margin-bottom: 8rpx;
}

.issue-group-title {
  padding: 24rpx 16rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-2);
}

/* ===== 机型图片选择弹层（转转式） ===== */
.model-sheet {
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

.model-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.model-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}

.model-sheet-body {
  max-height: 60vh;
}

.model-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 16rpx 24rpx;
}

.model-item {
  width: 33.33%;
  padding: 20rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.model-item.active {
  border-color: var(--brand);
  background: var(--brand-light);
}

.model-img {
  width: 160rpx;
  height: 160rpx;
}

.model-item-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-1);
  text-align: center;
  line-height: 1.3;
}

/* 无图占位：CSS 画手机轮廓 */
.model-ph {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f6f8;
  border-radius: 16rpx;
}

.model-ph-body {
  width: 76rpx;
  height: 136rpx;
  border: 6rpx solid #c9cdd4;
  border-radius: 16rpx;
  position: relative;
  background: #fff;
}

.model-ph-camera {
  position: absolute;
  top: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 28rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #c9cdd4;
}

.model-empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
}

.footer {
  padding: 48rpx 32rpx 0;
}

.footer-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
