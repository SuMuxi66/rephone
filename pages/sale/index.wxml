<view class="page">
  <view class="search-wrap">
    <view class="search-box">
      <t-icon name="search" size="36rpx" color="#99A39D" />
      <input
        class="search-input"
        placeholder="搜索品牌 / 型号 / 成色"
        placeholder-class="search-ph"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
      />
    </view>
  </view>

  <view class="promise">
    <view class="promise-item">
      <t-icon name="verified" size="32rpx" color="#1A5CE8" />
      <text>官方质检</text>
    </view>
    <view class="promise-item">
      <t-icon name="check-circle" size="32rpx" color="#1A5CE8" />
      <text>库存实时</text>
    </view>
    <view class="promise-item">
      <t-icon name="service" size="32rpx" color="#1A5CE8" />
      <text>支持售后</text>
    </view>
  </view>

  <scroll-view wx:if="{{brands.length}}" scroll-x class="filter-row">
    <view
      class="chip {{activeBrand === '' ? 'chip--active' : ''}}"
      data-brand=""
      bindtap="switchBrand"
    >全部品牌</view>
    <view
      wx:for="{{brands}}"
      wx:key="*this"
      class="chip {{activeBrand === item ? 'chip--active' : ''}}"
      data-brand="{{item}}"
      bindtap="switchBrand"
    >{{item}}</view>
  </scroll-view>

  <scroll-view wx:if="{{conditions.length}}" scroll-x class="filter-row filter-row--tight">
    <view
      class="chip {{activeCondition === '' ? 'chip--active' : ''}}"
      data-condition=""
      bindtap="switchCondition"
    >全部成色</view>
    <view
      wx:for="{{conditions}}"
      wx:key="*this"
      class="chip {{activeCondition === item ? 'chip--active' : ''}}"
      data-condition="{{item}}"
      bindtap="switchCondition"
    >{{item}}</view>
  </scroll-view>

  <view class="sort-bar">
    <view
      wx:for="{{sorts}}"
      wx:key="key"
      class="sort-item {{activeSort === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchSort"
    >{{item.label}}</view>
    <text wx:if="{{filterActive}}" class="clear" bindtap="resetFilters">清空筛选</text>
    <text wx:else class="count">共 {{total}} 台</text>
  </view>
  <view wx:if="{{filterActive}}" class="result-count">共 {{total}} 台</view>

  <view wx:if="{{!visible.length && loadStatus !== 1}}" class="empty">
    <t-empty description="没有符合条件的机型" />
  </view>

  <view class="grid">
    <view
      wx:for="{{visible}}"
      wx:key="id"
      class="card"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <image wx:if="{{item.image}}" class="card-img" src="{{item.image}}" mode="aspectFill" />
      <view wx:else class="card-img card-img--empty"><text>暂无图片</text></view>
      <view class="card-body">
        <view class="card-title">{{item.name}}</view>
        <view wx:if="{{item.conditionLevel || item.storage || item.tagTop.length}}" class="card-meta">
          <text wx:if="{{item.conditionLevel}}" class="meta-tag">{{item.conditionLevel}}</text>
          <text wx:if="{{item.storage}}" class="meta-tag">{{item.storage}}</text>
          <text wx:if="{{item.tagTop.length}}" class="meta-tag meta-tag--quality">{{item.tagTop[0]}}</text>
        </view>
        <view wx:if="{{item.descText}}" class="card-desc">{{item.descText}}</view>
        <view class="card-foot">
          <view class="price-wrap">
            <text class="price-symbol">¥</text>
            <text class="price">{{item.priceText}}</text>
            <text wx:if="{{item.originText}}" class="origin">¥{{item.originText}}</text>
          </view>
          <text class="stock">{{item.stockText}}</text>
        </view>
      </view>
    </view>
  </view>

  <t-load-more status="{{loadStatus}}" list-is-empty="{{!visible.length}}" bind:retry="onRetry" />
</view>
