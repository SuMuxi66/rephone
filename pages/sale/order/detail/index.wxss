.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 200rpx;
}

.status-card {
  background: var(--bg-card);
  margin: var(--space-page);
  padding: 32rpx;
  border-radius: var(--radius-card);
}

.status-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
}

.price-row {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.price-label {
  font-size: 24rpx;
  color: var(--text-3);
}

.price {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--money);
}

.tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx var(--space-page);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-light);
}

.footer-btn {
  flex: 1;
}

.popup {
  padding: 40rpx var(--space-page);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
}

.popup-title {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}
