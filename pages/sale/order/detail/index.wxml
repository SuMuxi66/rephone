<view class="page" wx:if="{{order}}">
  <view class="status-card">
    <view class="status-row">
      <text class="status-text">{{order.statusDesc}}</text>
      <status-tag biz="sale" status="{{order.status}}" />
    </view>
    <view class="price-row">
      <text class="price-label">实付</text>
      <text class="price">¥{{totalText}}</text>
    </view>
    <view wx:if="{{order.status === 90}}" class="tip">已退款 ¥{{refundText}}{{order.refundReason ? '（' + order.refundReason + '）' : ''}}</view>
    <view wx:if="{{order.status === 80}}" class="tip">订单已取消{{order.refundReason ? '（' + order.refundReason + '）' : ''}}</view>
  </view>

  <t-cell-group theme="card">
    <t-cell title="商品" note="{{order.goodsName}}" />
    <t-cell title="单价" note="¥{{priceText}}" />
    <t-cell title="数量" note="x{{order.quantity}}" />
    <t-cell title="订单号" note="{{order.orderNo}}" arrow bind:click="copyOrderNo" />
    <t-cell title="下单时间" note="{{createTimeText}}" />
  </t-cell-group>

  <t-cell-group theme="card">
    <t-cell title="收货人" note="{{order.receiverName}} {{order.receiverPhone}}" />
    <t-cell title="收货地址" note="{{order.receiverAddr}}" />
    <t-cell wx:if="{{order.expressNo}}" title="快递" note="{{order.expressCompany || ''}} {{order.expressNo}}" />
    <t-cell wx:if="{{order.remark}}" title="备注" note="{{order.remark}}" />
    <t-cell wx:if="{{order.adminRemark}}" title="商家备注" note="{{order.adminRemark}}" />
  </t-cell-group>

  <view class="footer" wx:if="{{order.status === 10 || order.status === 20 || order.status === 30}}">
    <block wx:if="{{order.status === 10}}">
      <view class="footer-btn"><t-button theme="default" block bindtap="onCancel">取消订单</t-button></view>
      <view class="footer-btn"><t-button theme="primary" block loading="{{submitting}}" bindtap="onPay">去支付 ¥{{totalText}}</t-button></view>
    </block>
    <block wx:if="{{order.status === 30}}">
      <view class="footer-btn"><t-button theme="default" block bindtap="showAfterSalePopup">申请售后</t-button></view>
      <view class="footer-btn"><t-button theme="primary" block bindtap="onConfirm">确认收货</t-button></view>
    </block>
    <block wx:if="{{order.status === 20}}">
      <view class="footer-btn"><t-button theme="default" block bindtap="showAfterSalePopup">申请售后</t-button></view>
    </block>
  </view>

  <t-popup visible="{{afterSalePopupVisible}}" placement="bottom" bind:visible-change="hideAfterSalePopup">
    <view class="popup">
      <view class="popup-title">申请售后（仅退款）</view>
      <t-input label="申请原因" placeholder="请填写申请原因" value="{{afterSaleForm.reason}}" bindchange="onAfterSaleReasonInput" />
      <t-button theme="primary" block loading="{{submitting}}" bindtap="submitAfterSale">提交申请</t-button>
    </view>
  </t-popup>
</view>
