.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 200rpx;
}

.hero {
  padding: 48rpx var(--space-page) 40rpx;
  background: linear-gradient(160deg, #ff7a3d 0%, #1A5CE8 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-badge {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-no {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.hero-meta {
  margin-top: 16rpx;
  display: flex;
  gap: 28rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.card {
  margin: var(--space-page);
  padding: 28rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
}

.card-title,
.group-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.stat-row {
  display: flex;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
}

.stat-num--brand {
  color: var(--brand);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.hint {
  margin-top: 24rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
}

.hint--warn {
  background: #E8F0FE;
  color: var(--warning);
}

.hint--ok {
  background: #f0f9f1;
  color: var(--success);
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-light);
}

.row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.row-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.row-name {
  font-size: 26rpx;
  color: var(--text-1);
}

.row-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.row-result {
  flex: none;
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.row-result--ok {
  color: var(--success);
}

.row-result--warn {
  color: var(--warning);
}

.summary {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-2);
}

.img-list {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #EDEBE4;
}

.empty {
  padding-top: 160rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx var(--space-page);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-light);
}
