.repair-page {
  min-height: 100vh;
  background: var(--bg-page);
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 60rpx);
}

.status-card {
  margin: 24rpx var(--space-page);
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.status-text {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
}

.status-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.price-row {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.price-label {
  font-size: 26rpx;
  color: var(--text-2);
}

.price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--money);
}

.warranty-line {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--success);
}

.canceled-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.timeline-card {
  margin: 0 var(--space-page) 24rpx;
  padding: 32rpx 24rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
}

.section-title {
  margin: 8rpx var(--space-page) 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 0 var(--space-page) 24rpx;
}

.photo-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
}

.footer {
  padding: 48rpx 32rpx 0;
}
