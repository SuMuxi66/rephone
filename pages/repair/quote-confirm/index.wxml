<view class="page" wx:if="{{order}}">
  <view class="order-card">
    <view class="order-line">
      <text class="label">机型</text>
      <text class="value">{{order.brandName}} {{order.modelName}}</text>
    </view>
    <view class="order-line">
      <text class="label">维修项目</text>
      <text class="value">{{itemsText}}</text>
    </view>
    <view class="order-line" wx:if="{{order.remark}}">
      <text class="label">故障描述</text>
      <text class="value">{{order.remark}}</text>
    </view>
  </view>

  <block wx:if="{{quote}}">
    <view class="quote-card">
      <view class="quote-amount-row">
        <text class="quote-label">维修报价</text>
        <text class="quote-amount">¥{{amountText}}</text>
      </view>
      <view wx:if="{{quote.description}}" class="quote-desc">{{quote.description}}</view>
      <view wx:if="{{quote.images.length}}" class="photo-grid">
        <image
          wx:for="{{quote.images}}"
          wx:key="index"
          src="{{item}}"
          mode="aspectFill"
          class="photo-thumb"
          data-index="{{index}}"
          bindtap="previewImage"
        />
      </view>
      <view class="quote-time">报价时间 {{quote.createTime}}</view>
    </view>

    <view class="actions">
      <view wx:if="{{quote.status === 1}}" class="btn-row">
        <t-button theme="default" bindtap="onReject">拒绝报价</t-button>
        <t-button theme="primary" loading="{{acting}}" bindtap="onAccept">接受报价</t-button>
      </view>
      <block wx:elif="{{order.status === 38}}">
        <view class="state-hint">报价已接受，请完成支付，维修随即开始</view>
        <t-button theme="primary" block loading="{{acting}}" bindtap="onPay">立即支付 ¥{{amountText}}</t-button>
      </block>
      <block wx:elif="{{quote.status === 2}}">
        <view class="state-hint">报价已接受，维修进行中，可在订单详情查看进度</view>
        <t-button theme="primary" block bindtap="backToDetail">返回订单详情</t-button>
      </block>
      <block wx:elif="{{quote.status === 3}}">
        <view class="state-hint">已拒绝该报价，商家重新报价后可在此确认</view>
        <t-button theme="primary" block bindtap="backToDetail">返回订单详情</t-button>
      </block>
    </view>
  </block>
  <view wx:elif="{{!loading}}" class="empty-state">
    <text class="empty-text">商家检测完成后会在此提交报价</text>
  </view>
</view>
<view wx:else class="empty-state">
  <text class="empty-text">{{loading ? '加载中...' : '订单不存在或无权查看'}}</text>
</view>
