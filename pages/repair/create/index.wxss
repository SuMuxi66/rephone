.repair-page {
  min-height: 100vh;
  background: var(--bg-page);
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 60rpx);
}

.summary-card {
  margin: 24rpx var(--space-page);
  padding: 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-card);
}

.summary-model {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}

.summary-items {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-2);
}

.summary-total {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--brand);
  font-weight: 600;
}

.form-body {
  padding: 8rpx 0;
}

.field-error {
  padding: 0 32rpx 12rpx;
  font-size: 24rpx;
  color: var(--danger);
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 16rpx 16rpx;
}

.photo-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed var(--border-light);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--text-3);
}

.photo-add-icon {
  font-size: 56rpx;
  line-height: 1;
  color: var(--text-3);
}

.photo-add-text {
  font-size: 22rpx;
}

.footer {
  padding: 48rpx 32rpx 0;
}

.footer-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
}
